# 블로그 에디터(/editor) 설정. 로컬에서는 .env.local로 복사해서 쓰고, Vercel에는 Environment Variables로 등록한다.

# GitHub OAuth App (Settings → Developer settings → OAuth Apps)
#   Homepage URL:               https://hyeryongdev.vercel.app
#   Authorization callback URL: https://hyeryongdev.vercel.app/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# next-auth: `openssl rand -base64 32` 로 만든 값
NEXTAUTH_SECRET=
# 로컬: http://localhost:3000 / Vercel에서는 생략 가능
NEXTAUTH_URL=http://localhost:3000

# (선택) 기본값: HyeryongChoi / HyeryongChoi / hyeryong.dev / main
# EDITOR_ALLOWED_LOGIN=
# EDITOR_REPO_OWNER=
# EDITOR_REPO_NAME=
# EDITOR_REPO_BRANCH=
